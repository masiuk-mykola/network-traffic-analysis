# Capture API simulator settings. Copy to .env (optional) — every value below is the default.

# World seed: the whole capture (traffic, incident, ids, payloads, PCAPs) derives from it.
CAP_SEED=demo
# Capture epoch T (ISO-8601 with a zone); history covers [T-72h, T], the live tail grows after T.
CAP_EPOCH=2025-10-27T12:00:00Z
# Bind address and port of the HTTP server.
CAP_HOST=127.0.0.1
CAP_PORT=8700
# Access token lifetime in seconds (the expiring-tokens chaos profile uses 15).
CAP_ACCESS_TTL_S=90
# A refresh token expires after this many idle seconds.
CAP_REFRESH_IDLE_S=1800
# A session (token family) can be refreshed for at most this many seconds after sign-in.
CAP_REFRESH_MAX_S=28800
# Initial chaos profile: calm | flaky | storm | degraded-pcap | expiring-tokens.
CAP_CHAOS=calm
# X-Admin-Token for the dev-only admin and observer endpoints (local use only).
CAP_ADMIN_TOKEN=lf-dev-admin
# Comma-separated Origin allowlist for the WebSocket live tap (where your UI runs).
CAP_ALLOWED_ORIGINS=http://localhost:3000
# Keep every recorded request (1/0) instead of the last 10k; also stops the teammate bot.
CAP_FULL_HISTORY=0
# Teammate bot (1/0): edits CASE-0002 every 90 s so stale ETags get 412.
CAP_TEAMMATE_BOT=1
# HMAC key for opaque cursors; empty = derived from CAP_SEED.
CAP_CURSOR_SECRET=
# Log level: critical | error | warning | info | debug | trace.
CAP_LOG_LEVEL=info
